# Copy to .env (or export these) before launching rss-mcp if you prefer env-driven config.
# The MCP client normally passes these in its "env" block instead.

# Where the SQLite file lives. --db on the command line wins over this.
RSS_MCP_DB=./data/feeds.db

# Allow localhost/LAN feed URLs (blocked by default as an SSRF guard).
RSS_MCP_ALLOW_PRIVATE_HOSTS=0

# HTTP behaviour.
RSS_MCP_HTTP_TIMEOUT=20
RSS_MCP_MAX_DOWNLOAD_BYTES=5000000
# RSS_MCP_USER_AGENT=rss-mcp/0.1 (+https://example.invalid)

# Storage behaviour.
RSS_MCP_MAX_ENTRIES_PER_FEED=500
RSS_MCP_SUMMARY_CHARS=600

# stderr log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
RSS_MCP_LOG_LEVEL=INFO
