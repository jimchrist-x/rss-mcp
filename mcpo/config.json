{
  "mcpServers": {
    "time": {
      "command": "uvx",
      "args": ["mcp-server-time", "--local-timezone=UTC"]
    },
    "rss": {
      "command": "uvx",
      "args": [
        "--from",
        "/home/user/rss-mcp",
        "rss-mcp",
        "--db",
        "/home/user/rss-mcp/data/feeds.db"
      ]
    }
  }
}
